<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>EducationPortal.Infrastructure</RootNamespace>
    <AssemblyName>EducationPortal.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="AWSSDK.SecretsManager" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" />
    <PackageReference Include="Google.Cloud.SecretManager.V1" />
    <PackageReference Include="Microsoft.Extensions.Resilience" />
    <PackageReference Include="VaultSharp" />
    <!-- Logs, metrics and traces over OTLP (ADR-007). -->
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- Common passwords for PasswordPolicyValidator (SEC-AUTHN-03). Source and licence: CommonPasswords.LICENSE.txt -->
    <EmbeddedResource Include="Identity\CommonPasswords.txt.gz" LogicalName="EducationPortal.Infrastructure.Identity.CommonPasswords.txt.gz" />
    <!-- Countries, states and cities for the address dropdowns (LocationDataImporter). Source and licence: the file's "source" block; rebuild with scripts/update-location-data.cs -->
    <EmbeddedResource Include="Data\Locations\locations.json" LogicalName="EducationPortal.Infrastructure.Data.Locations.locations.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\Application.csproj" />
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>

</Project>
