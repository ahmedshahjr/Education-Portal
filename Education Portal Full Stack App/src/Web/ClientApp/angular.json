{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "EducationPortal.Web": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:application": {
          "strict": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "src/assets",
              {
                "glob": "favicon.png",
                "input": "src",
                "output": "/"
              },
              {
                "glob": "*/messages.json",
                "input": "src/locale",
                "output": "/i18n"
              }
            ],
            "styles": [
              "src/styles.scss"
            ],
            "scripts": [],
            "polyfills": [
              "@angular/localize/init"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.1mb",
                  "maximumError": "1.6mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kb",
                  "maximumError": "8kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            },
            "testing": {
              "aot": false,
              "optimization": false,
              "extractLicenses": false,
              "assets": [
                "src/assets"
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "EducationPortal.Web:build:production"
            },
            "development": {
              "proxyConfig": "proxy.conf.js",
              "buildTarget": "EducationPortal.Web:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "EducationPortal.Web:build",
            "format": "json",
            "outputPath": "src/locale/en"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "reporters": [
              "default"
            ],
            "coverageReporters": [
              "html",
              "text-summary"
            ],
            "buildTarget": ":build:testing",
            "runner": "vitest"
          }
        }
      },
      "i18n": {
        "sourceLocale": "en"
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
