{
  "name": "educationportal.web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "run-script-os",
    "prestart": "npm run generate-api",
    "start:windows": "ng serve --port %PORT%",
    "start:default": "ng serve --port $PORT",
    "prebuild": "npm run generate-api",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "generate-api": "nswag run /runtime:Net100"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/localize": "^22.2.5",
    "@angular/material": "^22.2.6",
    "@angular/platform-browser": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@lucide/angular": "^1.71.0",
    "run-script-os": "^1.1.6",
    "rxjs": "~7.8.1",
    "tslib": "^2.5.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@types/node": "^24.0.0",
    "jsdom": "^30.1.2",
    "nswag": "latest",
    "typescript": "~7.0.2",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "esbuild": true,
    "lmdb": true,
    "msgpackr-extract": true
  }
}
