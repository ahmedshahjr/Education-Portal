@Web_HostAddress = https://localhost:7052
@XsrfToken = <copy the __Host-XSRF-TOKEN cookie value from the first response here>
@AuthCookieValue = <copy the __Host-EducationPortal cookie value from the login response here>

# GET Users Me
# Anonymous, so it returns 401 unless a session cookie is sent. Its response sets the __Host-XSRF-TOKEN cookie,
# whose value goes into @XsrfToken for the unsafe requests below.
GET {{Web_HostAddress}}/api/Users/me

###

# POST Users Login
# Signs in as the Development-only seed administrator. Copy the __Host-EducationPortal cookie from the response into @AuthCookieValue.
POST {{Web_HostAddress}}/api/Users/login
Content-Type: application/json
X-XSRF-TOKEN: {{XsrfToken}}
Cookie: __Host-XSRF-TOKEN={{XsrfToken}}

{
  "email": "administrator@localhost",
  "password": "Local-Dev-Only-2026!"
}

###

# GET Users Me (signed in)
GET {{Web_HostAddress}}/api/Users/me
Cookie: __Host-EducationPortal={{AuthCookieValue}}

###

# POST Users Logout
POST {{Web_HostAddress}}/api/Users/logout
Content-Type: application/json
X-XSRF-TOKEN: {{XsrfToken}}
Cookie: __Host-EducationPortal={{AuthCookieValue}}; __Host-XSRF-TOKEN={{XsrfToken}}

{}

###

# GET Health (Development only)
GET {{Web_HostAddress}}/health

###
