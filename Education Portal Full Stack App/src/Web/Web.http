# For more info on HTTP files go to https://aka.ms/vs/httpfile
@Web_HostAddress = https://localhost:7052
@AuthCookieName = .AspNetCore.Identity.Application
@AuthCookieValue = <AuthCookieValue>

# POST Users Login
# Logs in as the seeded development administrator. Copy the value of the
# .AspNetCore.Identity.Application cookie from the response into @AuthCookieValue.
POST {{Web_HostAddress}}/api/Users/login?useCookies=true
Content-Type: application/json

{
  "email": "administrator@localhost",
  "password": "Administrator1!"
}

###

# GET Users Manage Info
GET {{Web_HostAddress}}/api/Users/manage/info
Cookie: {{AuthCookieName}}={{AuthCookieValue}}

###

# POST Users Logout
POST {{Web_HostAddress}}/api/Users/logout
Cookie: {{AuthCookieName}}={{AuthCookieValue}}
Content-Type: application/json

{}

###

# GET Health (Development only)
GET {{Web_HostAddress}}/health

###
